{
  "expo": {
    "name": "BLACKSPOT YOU",
    "slug": "blackspot-you",
    "owner": "blinkydating",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "blackspotyou",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.blackspotyou.app",
      "buildNumber": "2",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.blackspotyou.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#18131F"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BLACKSPOT YOU utilise votre position pour afficher précisément les lieux situés dans un rayon de 500 mètres autour de vous."
        }
      ],
      "react-native-maps"
    ],
    "extra": {
      "eas": {
        "projectId": "fbd1b684-c8fe-49be-adfa-790e87d521e3"
      }
    }
  }
}
