{
  "expo": {
    "name": "BLACKSPOT YOU",
    "slug": "blackspot-you",
    "owner": "blinkydating",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "blackspotyou",
    "ios": {
      "bundleIdentifier": "com.blackspotyou.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.blackspotyou.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BLACKSPOT YOU utilise votre position pour afficher les lieux à proximité."
        }
      ],
      "react-native-maps"
    ],
    "extra": {
      "eas": {
        "projectId": "fbd1b684-c8fe-49be-adfa-790e87d521e3"
      }
    }
  }
}
